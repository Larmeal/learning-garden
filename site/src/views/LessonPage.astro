---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import LessonNav from '../components/LessonNav.astro';
import Pips from '../components/Pips';
import Plant from '../components/Plant';
import LangMenu from '../components/LangMenu.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import MdLink from '../components/MdLink.astro';
import GrowthBadge from '../components/GrowthBadge';
import LessonArt from '../components/LessonArt';
import Outro from '../components/Outro';
import ProgressToggle from '../components/ProgressToggle';
import PageList from '../components/PageList';
import { ui, type Lang } from '../i18n';
import { groupsOf, hasLang, hasPage, homeHref, lessonHref, pageInfo, pageKey, parentSlug, slugOf, subjectHref, subjectOf, subjectText, pad, type Lesson } from '../lib/garden';

interface Props {
  lang: Lang;
  lesson: Lesson;
}
const { lang, lesson } = Astro.props;
const t = ui[lang];
const subject = await getEntry('subjects', subjectOf(lesson.id));
if (!subject) throw new Error(`${lesson.id}: no subject file src/content/subjects/${subjectOf(lesson.id)}.json`);
const text = subjectText(subject, lang);

// The same page in the other language, or that language's subject page when this page has no translation.
const other: Lang = lang === 'th' ? 'en' : 'th';
const altHref = (await hasPage(lesson.id, other)) ? lessonHref(lesson.id, other) : (await hasLang(subject.id, other)) ? subjectHref(subject.id, other) : undefined;

const groups = await groupsOf(subject.id, lang);
const group = groups.find((g) => slugOf(g.main.id) === parentSlug(lesson.id))!;
const main = group.main;
const isSub = lesson.id !== main.id;
const pageId = pageKey(lesson.id);
// Reading order runs through every page: a lesson's overview, its sub-pages, then the next lesson.
const sequence = groups.flatMap((g) => g.pages);
const index = sequence.findIndex((l) => l.id === lesson.id);
const prev = sequence[index - 1];
const next = sequence[index + 1];
const needs = isSub ? [] : main.data.requires.map((r) => groups.find((g) => slugOf(g.main.id) === r)!.main);
const unlocks = groups.filter((g) => g.main.data.requires.includes(slugOf(main.id))).map((g) => g.main);
const pages = group.pages.map((p) => pageInfo(p, main, lang));
const pageIds = pages.map((p) => p.id);
const lessonsPages = groups.map((g) => g.pages.map((p) => pageKey(p.id)));
const kind = isSub ? lesson.data.kind : 'main';
const { Content, headings } = await render(lesson);
const outline = headings.filter((h) => h.depth === 2);
const isSteps = lesson.data.format === 'steps';
---

<Base lang={lang} altHref={altHref} title={isSub ? `${main.data.title}: ${lesson.data.title}` : lesson.data.title} description={lesson.data.summary} accent={subject.data.accent} accentDark={subject.data.accentDark} format={lesson.data.format}>
  {
    isSteps && (
      <div class="player-bar">
        <a class="icon-btn" href={subjectHref(subject.id, lang)} aria-label={t.lesson.backToMap}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </a>
        <div class="seg-track" data-track role="progressbar" aria-label={t.lesson.progress}></div>
        <span class="bar-plant" data-bar-plant aria-hidden="true"><Plant stage="sprout" size={34} sway /></span>
        <button class="btn sm" type="button" data-toggle-view>{t.lesson.readLong}</button>
        <LangMenu lang={lang} altHref={altHref} scope="player" />
        <ThemeToggle label={t.themeToggle} />
      </div>
    )
  }

  <main class="page">
    <div class="container wide">
      <nav class="crumbs" aria-label={t.breadcrumb}>
        <a href={homeHref(lang)}>{t.home}</a><span>/</span>
        <a href={subjectHref(subject.id, lang)}>{text.name}</a><span>/</span>
        {isSub && (<><a href={lessonHref(main.id, lang)}>{main.data.title}</a><span>/</span></>)}
        <span>{lesson.data.title}</span>
      </nav>

      <div class={`lesson-layout${outline.length > 1 ? ' with-toc' : ''}`} style="margin-top:24px">
        <aside class="lesson-aside">
          {
            isSteps && (
              <div class="mode-card">
                <span>{t.lesson.readingLong}</span>
                <button class="btn primary sm read-only-btn" type="button" data-toggle-view>{t.lesson.stepMode}</button>
              </div>
            )
          }
          <LessonNav groups={groups} phases={text.phases} currentId={lesson.id} lang={lang} />
        </aside>

        <article>
          {
            isSteps && (
              <div class="mode-card mode-card-top">
                <span>{t.lesson.readingLong}</span>
                <button class="btn primary sm read-only-btn" type="button" data-toggle-view>{t.lesson.stepMode}</button>
              </div>
            )
          }
          <details class="lesson-toc-mobile" style="margin-bottom:24px">
            <summary>{t.lesson.toc}</summary>
            <div style="margin-top:12px"><LessonNav groups={groups} phases={text.phases} currentId={lesson.id} lang={lang} /></div>
          </details>

          <header class="lesson-head">
            <h1>{lesson.data.title}</h1>
            <p class="summary">{lesson.data.summary}</p>
            <div class="lesson-meta">
              {isSub && (
                <span class="pk-group">
                  <span class={`pk ${kind}`}>{t.kind[kind]}</span>
                  <a class="pk-of" href={lessonHref(main.id, lang)}>{t.lesson.ofLesson(main.data.title)}</a>
                </span>
              )}
              <span>{t.lesson.topic(pad(main.data.order), main.data.phase!)}</span>
              <span>{t.lesson.difficulty} <Pips level={main.data.level!} lang={lang} /></span>
              <GrowthBadge client:load pages={pageIds} content={main.data.stage} lang={lang} />
            </div>
            {
              needs.length > 0 && (
                <div class="lesson-meta">
                  <span>{t.lesson.needs}</span>
                  {needs.map((n) => (
                    <a class="chip" href={lessonHref(n.id, lang)}>
                      {pad(n.data.order)} {n.data.title}
                    </a>
                  ))}
                </div>
              )
            }
            {pages.length > 1 && <PageList client:load pages={pages} currentId={pageId} lang={lang} />}
          </header>

          <div class="prose" data-steps-root data-lesson-id={pageId} data-t-start={t.lesson.start} data-t-finish={t.lesson.finish} data-t-onward={t.lesson.onward} data-t-step-word={t.lesson.stepWord}>
            {
              isSteps && (
                <section class="step step-only step-intro" data-step data-kind="intro" tabindex="-1">
                  <div class="intro-card">
                    <div class="art-wrap"><LessonArt client:load pages={pageIds} content={main.data.stage} /></div>
                    <h1>{lesson.data.title}</h1>
                    <p class="summary">{lesson.data.summary}</p>
                    <div class="lesson-meta">
                      {isSub && (
                <span class="pk-group">
                  <span class={`pk ${kind}`}>{t.kind[kind]}</span>
                  <a class="pk-of" href={lessonHref(main.id, lang)}>{t.lesson.ofLesson(main.data.title)}</a>
                </span>
              )}
                      <span>{t.lesson.phase(main.data.phase!)}</span>
                      <span>{t.lesson.difficulty} <Pips level={main.data.level!} lang={lang} /></span>
                      <span data-step-count></span>
                    </div>
                    {
                      needs.length > 0 && (
                        <div class="lesson-meta">
                          <span>{t.lesson.needs}</span>
                          {needs.map((n) => (
                            <a class="chip" href={lessonHref(n.id, lang)}>{pad(n.data.order)} {n.data.title}</a>
                          ))}
                        </div>
                      )
                    }
                    {pages.length > 1 && <PageList client:load pages={pages} currentId={pageId} lang={lang} />}
                  </div>
                </section>
              )
            }

            <Content components={{ a: MdLink }} />

            {
              isSteps && (
                <section class="step step-only step-outro" data-step data-kind="outro" tabindex="-1">
                  <Outro
                    client:load
                    pageId={pageId}
                    pages={pages}
                    lessons={lessonsPages}
                    nextHref={next ? lessonHref(next.id, lang) : undefined}
                    nextTitle={next?.data.title}
                    nextIsSameLesson={!!next && parentSlug(next.id) === parentSlug(lesson.id)}
                    mapHref={subjectHref(subject.id, lang)}
                    subjectName={text.name}
                    lang={lang}
                  />
                </section>
              )
            }
          </div>

          <footer class="lesson-foot">
            <div><ProgressToggle client:load pageId={pageId} pages={pages} lang={lang} /></div>
            {
              unlocks.length > 0 && (
                <div class="lesson-meta">
                  <span>{t.lesson.unlocks}</span>
                  {unlocks.map((n) => (
                    <a class="chip" href={lessonHref(n.id, lang)}>
                      {pad(n.data.order)} {n.data.title}
                    </a>
                  ))}
                </div>
              )
            }
            <div class="pager">
              {prev && (<a class="prev" href={lessonHref(prev.id, lang)}><small>{t.lesson.prev}</small><span>{prev.data.title}</span></a>)}
              {next && (<a class="next" href={lessonHref(next.id, lang)}><small>{t.lesson.next}</small><span>{next.data.title}</span></a>)}
            </div>
          </footer>
        </article>

        {
          outline.length > 1 && (
            <nav class="toc" aria-label={t.lesson.onThisPage}>
              <h4>{t.lesson.onThisPage}</h4>
              <ul>
                {outline.map((h) => (
                  <li><a href={`#${h.slug}`}>{h.text}</a></li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </div>
  </main>

  {
    isSteps && (
      <div class="player-foot" data-pfoot>
        <div class="inner">
          <button class="btn" type="button" data-back>{t.lesson.back}</button>
          <span class="spacer"></span>
          <button class="btn" type="button" data-skip hidden>{t.lesson.skip}</button>
          <button class="btn primary lg" type="button" data-next>{t.lesson.start}</button>
        </div>
      </div>
    )
  }

  <script>
    // Outline highlight for reading mode.
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
    const byId = new Map(links.map((a) => [a.hash.slice(1), a]));
    if (links.length) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            links.forEach((a) => a.classList.remove('active'));
            byId.get(e.target.id)?.classList.add('active');
          }
        },
        { rootMargin: '0px 0px -70% 0px' },
      );
      byId.forEach((_, id) => {
        const el = document.getElementById(id);
        if (el) io.observe(el);
      });
    }
  </script>

  <script>
    // Step player: shows one card at a time, gates question cards until answered, and records completion.
    const root = document.documentElement;
    const stage = document.querySelector<HTMLElement>('[data-steps-root]');

    function setView(view: 'steps' | 'read') {
      root.dataset.view = view;
      try { localStorage.setItem('garden:view', view); } catch {}
    }

    if (stage && root.dataset.format === 'steps') {
      const steps = Array.from(stage.querySelectorAll<HTMLElement>('[data-step]'));
      const last = steps.length - 1;
      const track = document.querySelector<HTMLElement>('[data-track]')!;
      const foot = document.querySelector<HTMLElement>('[data-pfoot]')!;
      const nextBtn = document.querySelector<HTMLButtonElement>('[data-next]')!;
      const backBtn = document.querySelector<HTMLButtonElement>('[data-back]')!;
      const skipBtn = document.querySelector<HTMLButtonElement>('[data-skip]')!;
      const lessonId = stage.dataset.lessonId!;
      const label = { start: stage.dataset.tStart!, finish: stage.dataset.tFinish!, onward: stage.dataset.tOnward!, stepWord: stage.dataset.tStepWord! };
      const contentCount = last - 1;

      steps.forEach((s, k) => s.dataset.index = String(k));
      for (let k = 0; k < contentCount; k++) track.appendChild(document.createElement('span'));
      const segs = Array.from(track.children) as HTMLElement[];
      document.querySelectorAll('[data-step-count]').forEach((el) => (el.textContent = `${contentCount} ${label.stepWord}`));

      let i = 0;
      const gated = (s: HTMLElement) => s.dataset.gate === 'question' && !s.dataset.answered;

      const barPlant = document.querySelector<HTMLElement>('[data-bar-plant]');
      // A question counts as answered for good once it is stored; the outro asks to go back to the ones still missing.
      function unansweredIndex() {
        let quiz: string[] = [];
        try { quiz = JSON.parse(localStorage.getItem('garden:quiz') || '{}')[lessonId] ?? []; } catch {}
        return steps.findIndex((s) => {
          const key = s.querySelector<HTMLElement>('[data-q]')?.dataset.q;
          return s.dataset.gate === 'question' && key && !quiz.includes(key);
        });
      }
      window.addEventListener('garden:goto-unanswered', () => {
        const k = unansweredIndex();
        if (k >= 0) show(k);
      });

      function show(n: number, focus = true) {
        i = Math.max(0, Math.min(last, n));
        steps.forEach((s, k) => s.classList.toggle('is-current', k === i));
        segs.forEach((s, k) => {
          s.classList.toggle('done', k < i - 1);
          s.classList.toggle('current', k === i - 1);
        });
        track.setAttribute('aria-valuenow', String(Math.max(0, i - 1)));
        track.setAttribute('aria-valuemax', String(contentCount));
        foot.hidden = i === last;
        backBtn.disabled = i === 0;
        nextBtn.textContent = i === 0 ? label.start : i === last - 1 ? label.finish : label.onward;
        const g = gated(steps[i]);
        nextBtn.disabled = g;
        skipBtn.hidden = !g;
        barPlant?.style.setProperty('--p', String(Math.max(0, Math.min(1, (i - 1) / Math.max(1, contentCount)))));
        if (focus) {
          window.scrollTo({ top: 0 });
          steps[i].focus({ preventScroll: true });
        }
      }

      nextBtn.addEventListener('click', () => show(i + 1));
      backBtn.addEventListener('click', () => show(i - 1));
      skipBtn.addEventListener('click', () => {
        steps[i].dataset.answered = '1';
        show(i + 1);
      });
      stage.addEventListener('garden:answered', (e) => {
        const s = (e.target as HTMLElement).closest<HTMLElement>('[data-step]');
        if (!s) return;
        s.dataset.answered = '1';
        if (steps[i] === s) {
          nextBtn.disabled = false;
          skipBtn.hidden = true;
        }
      });
      document.addEventListener('keydown', (e) => {
        if (root.dataset.view !== 'steps') return;
        const t = e.target as HTMLElement;
        if (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA') return;
        if (e.key === 'ArrowRight' && !nextBtn.disabled && i < last) show(i + 1);
        if (e.key === 'ArrowLeft' && i > 0) show(i - 1);
      });
      document.querySelectorAll('[data-toggle-view]').forEach((b) =>
        b.addEventListener('click', () => {
          const v = root.dataset.view === 'steps' ? 'read' : 'steps';
          setView(v);
          if (v === 'steps') show(i, false);
        }),
      );
      // A link such as /data-quality/profiling/#some-heading opens the card that holds that heading.
      function cardOfHash() {
        let id = '';
        try { id = decodeURIComponent(location.hash.slice(1)); } catch { return -1; }
        const card = id ? document.getElementById(id)?.closest<HTMLElement>('[data-step]') : null;
        return card ? steps.indexOf(card) : -1;
      }
      const fromHash = cardOfHash();
      show(Math.max(0, fromHash), false);
      if (fromHash > 0) document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView({ block: 'start' });
      window.addEventListener('hashchange', () => {
        const k = cardOfHash();
        if (k >= 0) show(k, false);
      });
    }
  </script>
</Base>
