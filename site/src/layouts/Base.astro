---
import '../styles/global.css';
import { site } from '../site.config';
import FooterGarden from '../components/FooterGarden';
import LangMenu from '../components/LangMenu.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { ui, type Lang } from '../i18n';
import { homeHref } from '../lib/garden';

interface Props {
  title?: string;
  description?: string;
  accent?: string;
  accentDark?: string;
  // "steps" lets the lesson page offer the one-card-at-a-time player.
  format?: 'steps' | 'read';
  lang?: Lang;
  // The same page in the other language (there are two languages today). Without it the menu goes to that language's home page.
  altHref?: string;
}

const { title, description, accent, accentDark, format = 'read', lang = 'th', altHref } = Astro.props;
const t = ui[lang];
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const style = [accent && `--subject-accent:${accent}`, accentDark && `--subject-accent-dark:${accentDark}`]
  .filter(Boolean)
  .join(';');
---

<!doctype html>
<html lang={lang} style={style || undefined} data-format={format}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? t.tagline} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Prompt:wght@500;600;700&family=IBM+Plex+Sans+Thai:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      try {
        var t = localStorage.getItem('garden:theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        var v = localStorage.getItem('garden:view');
        document.documentElement.dataset.view = v === 'read' ? 'read' : 'steps';
      } catch (e) {
        document.documentElement.dataset.view = 'steps';
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={homeHref(lang)}>
          <span class="brand-mark" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21v-9" /><path d="M12 13c0-4 3-7 8-7 0 5-3 8-8 7z" /><path d="M12 16c0-3-2-5-6-5 0 4 2 6 6 5z" />
            </svg>
          </span>
          {site.name}
        </a>
        <div class="header-actions">
          <slot name="header-extra" />
          <LangMenu lang={lang} altHref={altHref} scope="header" />
          <ThemeToggle label={t.themeToggle} />
        </div>
      </div>
    </header>
    <slot />
    <FooterGarden client:visible />
    <footer class="site-footer">
      <div class="container">{site.name} · {t.footer}</div>
    </footer>
    <script>
      // The language menu is a <details>: close it on a click elsewhere or on Escape.
      const langMenus = document.querySelectorAll<HTMLDetailsElement>('.lang-menu');
      document.addEventListener('click', (e) => {
        langMenus.forEach((m) => {
          if (m.open && !m.contains(e.target as Node)) m.open = false;
        });
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        langMenus.forEach((m) => {
          if (!m.open) return;
          m.open = false;
          m.querySelector('summary')?.focus();
        });
      });
      const root = document.documentElement;
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) =>
        btn.addEventListener('click', () => {
          const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          const next = current === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('garden:theme', next); } catch {}
        }),
      );
    </script>
  </body>
</html>
