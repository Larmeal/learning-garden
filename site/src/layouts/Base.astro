---
import '../styles/global.css';
import { site } from '../site.config';
import FooterGarden from '../components/FooterGarden';

interface Props {
  title?: string;
  description?: string;
  accent?: string;
  accentDark?: string;
  // "steps" lets the lesson page offer the one-card-at-a-time player.
  format?: 'steps' | 'read';
}

const { title, description = site.tagline, accent, accentDark, format = 'read' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const style = [accent && `--subject-accent:${accent}`, accentDark && `--subject-accent-dark:${accentDark}`]
  .filter(Boolean)
  .join(';');
---

<!doctype html>
<html lang={site.lang} style={style || undefined} data-format={format}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Prompt:wght@500;600;700&family=IBM+Plex+Sans+Thai:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      try {
        var t = localStorage.getItem('garden:theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        var v = localStorage.getItem('garden:view');
        document.documentElement.dataset.view = v === 'read' ? 'read' : 'steps';
      } catch (e) {
        document.documentElement.dataset.view = 'steps';
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={`${base}/`}>
          <span class="brand-mark" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21v-9" /><path d="M12 13c0-4 3-7 8-7 0 5-3 8-8 7z" /><path d="M12 16c0-3-2-5-6-5 0 4 2 6 6 5z" />
            </svg>
          </span>
          {site.name}
        </a>
        <div class="header-actions">
          <button class="icon-btn" id="theme-toggle" type="button" aria-label="สลับธีมสว่าง/มืด">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </div>
      </div>
    </header>
    <slot />
    <FooterGarden client:visible />
    <footer class="site-footer">
      <div class="container">{site.name} · เนื้อหาเติบโตไปตามที่เรียน</div>
    </footer>
    <script>
      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('garden:theme', next); } catch {}
      });
    </script>
  </body>
</html>
