---
// A short aside inside a lesson. Use type="tip" for a shortcut, "warn" for something that bites, "try" for a hands-on step.
interface Props {
  type?: 'tip' | 'warn' | 'try' | 'note';
  title?: string;
}
const { type = 'note', title } = Astro.props;
---

<aside class={`callout callout-${type}`}>
  <span class="callout-ic" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      {type === 'tip' && (<><path d="M9 18h6" /><path d="M10 21h4" /><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3z" /></>)}
      {type === 'warn' && (<><path d="M12 3 2 20h20L12 3z" /><path d="M12 10v4" /><path d="M12 17h.01" /></>)}
      {type === 'try' && (<><path d="M9 3h6" /><path d="M10 3v6L4.5 19a1.5 1.5 0 0 0 1.3 2.2h12.4a1.5 1.5 0 0 0 1.3-2.2L14 9V3" /><path d="M7.5 14h9" /></>)}
      {type === 'note' && (<><path d="M5 4h11l3 3v13H5z" /><path d="M8 11h8" /><path d="M8 15h8" /></>)}
    </svg>
  </span>
  <div class="callout-body">
    {title && <strong class="callout-title">{title}</strong>}
    <slot />
  </div>
</aside>
