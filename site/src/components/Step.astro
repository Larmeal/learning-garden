---
// One card of a step-by-step lesson. In "reading" mode the cards simply stack as sections of a long page.
// kind="question" holds a <Question>; the player waits for an answer before it lets the learner continue.
interface Props {
  kind?: 'read' | 'question';
}
const { kind = 'read' } = Astro.props;
---

<section class={`step step-${kind}`} data-step data-gate={kind === 'question' ? 'question' : undefined} tabindex="-1">
  <slot />
</section>
