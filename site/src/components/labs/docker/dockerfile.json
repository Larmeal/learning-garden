{
  "steps": [
    {
      "size": "0B",
      "by": "LABEL org.example.course=docker"
    },
    {
      "size": "0B",
      "by": "ENV GREETING=hello"
    },
    {
      "size": "0B",
      "by": "WORKDIR /app"
    },
    {
      "size": "105B",
      "by": "COPY app.py . # buildkit"
    },
    {
      "size": "30.9kB",
      "by": "RUN python -c \"open('/app/built.txt', 'w').write('x' * 1000)"
    },
    {
      "size": "0B",
      "by": "EXPOSE [8080/tcp]"
    },
    {
      "size": "0B",
      "by": "CMD [\"python\" \"app.py\"]"
    }
  ],
  "baseLayers": 4,
  "imageLayers": 7,
  "pid1": {
    "exec form": "sleep 300",
    "shell form": "sleep 300",
    "shell form with &&": "/bin/sh -c sleep 300 && echo done"
  },
  "cmdResults": {
    "exec ENTRYPOINT + CMD": [
      "hello world",
      "hello docker"
    ],
    "shell ENTRYPOINT + CMD": [
      "hello",
      "hello"
    ],
    "CMD only": [
      "default",
      "error, exit code 127"
    ]
  }
}
