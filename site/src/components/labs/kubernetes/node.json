{
  "pod": {
    "sandboxProcess": "/pause",
    "containers": [
      "a",
      "b"
    ]
  },
  "namespaces": {
    "net": 1,
    "mnt": 3,
    "pid": 3
  },
  "cgroup": {
    "memoryMax": "67108864",
    "cpuMax": "10000 100000",
    "cpuWeight": 2,
    "usedPct": 10,
    "throttledPeriods": "31/31"
  },
  "cni": {
    "cidrs": {
      "garden": "10.244.0.0/24",
      "garden-m02": "10.244.1.0/24",
      "garden-m03": "10.244.2.0/24"
    },
    "plugin": "ptp + host-local + portmap"
  },
  "ttl": {
    "sameNode": 63,
    "otherNode": 62
  },
  "kubeletRestartKeepsContainers": true
}
