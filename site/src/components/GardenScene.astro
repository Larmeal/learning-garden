---
// Hero illustration: hills, sun (moon in dark mode) and a bed with plants of each maturity. Colors come from theme tokens.
import Plant from './Plant';
import type { PlantStage } from './Plant';

const plants: { stage: PlantStage; x: number; size: number }[] = [
  { stage: 'seed', x: 78, size: 64 },
  { stage: 'sprout', x: 150, size: 72 },
  { stage: 'sprout', x: 226, size: 84 },
  { stage: 'evergreen', x: 312, size: 108 },
  { stage: 'sprout', x: 424, size: 80 },
  { stage: 'evergreen', x: 500, size: 92 },
  { stage: 'seed', x: 588, size: 60 },
];
---

<svg class="scene" viewBox="0 0 680 400" role="img" aria-label="ภาพประกอบสวนเล็กๆ มีต้นไม้หลายขนาดตั้งแต่เมล็ดถึงต้นโต">
  <rect width="680" height="400" fill="var(--sky)" />
  <circle cx="548" cy="96" r="62" fill="var(--sun-moon)" opacity=".22" />
  <circle cx="548" cy="96" r="40" fill="var(--sun-moon)" />
  <g class="cloud"><ellipse cx="150" cy="86" rx="46" ry="16" /><ellipse cx="184" cy="74" rx="30" ry="15" /><ellipse cx="120" cy="78" rx="26" ry="12" /></g>
  <g class="cloud b"><ellipse cx="392" cy="140" rx="38" ry="12" /><ellipse cx="420" cy="130" rx="24" ry="12" /></g>
  <path d="M0 270 C 110 205, 250 215, 360 252 S 580 250, 680 215 V400 H0Z" fill="var(--hill-far)" />
  <path d="M0 318 C 140 276, 300 296, 430 312 S 600 306, 680 286 V400 H0Z" fill="var(--hill-near)" />
  <rect x="34" y="352" width="612" height="62" rx="31" fill="var(--soil)" />
  <rect x="34" y="352" width="612" height="10" rx="5" fill="var(--soil-dark)" opacity=".35" />
  {plants.map((p) => <Plant stage={p.stage} size={p.size} x={p.x - p.size / 2} y={366 - p.size * 0.86} sway />)}
</svg>
