---
// Stands in for <a> in lesson text, so a link can be written as a plain root-relative path:
// [lesson 3](/data-quality/profiling/) or [บท 3](/en/data-quality/profiling/).
// On GitHub Pages the site lives under /<repo>/, so a path that starts with "/" needs the base put in front.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { href = '', ...rest } = Astro.props;
const url = href.startsWith('/') && !href.startsWith('//') ? base + href : href;
---

<a href={url} {...rest}><slot /></a>
