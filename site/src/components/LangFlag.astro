---
// Flags are drawn as SVG because Windows does not render flag emoji (it shows the letters TH / GB instead).
// English uses the Union Jack. `uid` keeps the clipPath id unique when the same flag is on the page twice.
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  uid?: string;
}
const { lang, uid = 'x' } = Astro.props;
---

{lang === 'th' && (
  <svg class="flag" viewBox="0 0 30 20" width="24" height="16" aria-hidden="true" focusable="false">
    <rect width="30" height="20" fill="#A51931" />
    <rect y="3.34" width="30" height="13.32" fill="#F4F5F8" />
    <rect y="6.67" width="30" height="6.66" fill="#2D2A4A" />
  </svg>
)}
{lang === 'en' && (
  <svg class="flag" viewBox="0 0 60 30" width="24" height="16" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <clipPath id={`uk-${uid}`}><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" /></clipPath>
    <rect width="60" height="30" fill="#012169" />
    <path d="M0,0 L60,30 M60,0 L0,30" stroke="#FFFFFF" stroke-width="6" />
    <path d="M0,0 L60,30 M60,0 L0,30" clip-path={`url(#uk-${uid})`} stroke="#C8102E" stroke-width="4" />
    <path d="M30,0 v30 M0,15 h60" stroke="#FFFFFF" stroke-width="10" />
    <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
  </svg>
)}
