---
// Dev only (rendered by LessonPage.astro when running `astro dev`): the MDX source of the page, shown instead of the
// page while "Edit" is on. "View" saves first and only switches back when the text compiles and the page renders;
// the checks run in the /__edit middleware of astro.config.mjs.
import type { Lang } from '../i18n';
import DevEditToggle from './DevEditToggle.astro';

interface Props {
  lang: Lang;
  file: string;
  vscode?: string;
  alt?: string; // the same lesson in the other language
}
const { lang, file, vscode, alt } = Astro.props;
const en = lang === 'en';
const otherName = file.includes('lessons-en') ? (en ? 'Thai' : 'ไทย') : en ? 'English' : 'อังกฤษ';
---

<section
  class="dev-editor"
  data-file={file}
  data-t-loading={en ? 'Loading...' : 'กำลังโหลด...'}
  data-t-saving={en ? 'Checking and saving...' : 'กำลังตรวจและบันทึก...'}
  data-t-saved={en ? 'Saved' : 'บันทึกแล้ว'}
  data-t-failed={en ? 'Not saved, the page stays as it was:' : 'ยังไม่ได้บันทึก หน้ายังเป็นฉบับเดิม:'}
  data-t-compile={en ? 'The MDX does not compile' : 'MDX นี้ compile ไม่ผ่าน'}
  data-t-frontmatter={en ? 'The frontmatter (the block between the --- lines) is not valid' : 'frontmatter (ส่วนระหว่างบรรทัด ---) ไม่ถูกต้อง'}
  data-t-render={en ? 'The page could not render, the file was put back' : 'หน้านี้ render ไม่ได้ จึงคืนไฟล์เดิมให้แล้ว'}
  data-t-leave={en ? 'You have unsaved changes.' : 'มีการแก้ที่ยังไม่ได้บันทึก'}
  data-t-restored={en ? 'Your unsaved text was restored.' : 'กู้ข้อความที่ยังไม่ได้บันทึกของคุณกลับมาแล้ว'}
  data-t-sync-ok={en ? 'Thai and English are in step' : 'ภาษาไทยกับอังกฤษตรงกัน'}
  data-t-sync-units={en ? 'units' : 'หน่วย'}
  data-t-sync-en-behind={en ? 'English has not followed the Thai edit' : 'ภาษาอังกฤษยังไม่ตามที่แก้ฉบับไทย'}
  data-t-sync-th-behind={en ? 'English was edited alone, check that Thai still agrees' : 'ภาษาอังกฤษถูกแก้ฝั่งเดียว ตรวจว่าฉบับไทยยังตรงกันไหม'}
  data-t-sync-mismatch={en ? 'Thai and English have a different number of units, so they cannot be compared' : 'จำนวนหน่วยของไทยกับอังกฤษไม่เท่ากัน จึงเทียบกันไม่ได้'}
  data-t-sync-edited={en ? 'edited' : 'แก้เมื่อ'}
  data-t-sync-copied={en ? 'Copied' : 'คัดลอกแล้ว'}
  data-t-sync-today={en ? 'today' : 'วันนี้'}
  data-t-sync-days={en ? 'days ago' : 'วันก่อน'}
  data-t-links-none={en ? 'No lesson links to this page' : 'ยังไม่มีบทไหนลิงก์มาหน้านี้'}
  data-t-links-some={en ? 'links to this page or its headings (rename a heading only after changing these)' : 'ลิงก์มาที่หน้านี้หรือหัวข้อในหน้านี้ (ถ้าจะเปลี่ยนชื่อหัวข้อ ให้แก้ลิงก์เหล่านี้ก่อน)'}
  data-t-links-whole={en ? 'the page' : 'ทั้งหน้า'}
>
  <div class="dev-editor-head">
    <strong>{file}</strong>
    {vscode && <a href={vscode}>VS Code</a>}
  </div>
  <p class="dev-editor-hint">
    {en
      ? 'This is the MDX source of the lesson text, for both reading modes. Keep tags such as <Step> and <Question> whole. Press View to save and see the page. It only changes the file on this machine.'
      : 'ซอร์ส MDX ของเนื้อหาบทเรียน ใช้กับทั้งสองโหมดการอ่าน เก็บแท็กอย่าง <Step> และ <Question> ให้ครบ กด View เพื่อบันทึกและดูหน้า ไฟล์เปลี่ยนเฉพาะในเครื่องนี้'}
  </p>
  <div class="dev-sync" data-sync hidden>
    <p class="dev-sync-title" data-sync-title></p>
    <ul class="dev-sync-list" data-sync-list></ul>
    <div class="dev-sync-actions" data-sync-actions>
      <button type="button" class="btn sm" data-sync-copy>{en ? 'Copy what to translate' : 'คัดลอกรายการที่ต้องแปล'}</button>
      {alt && <a class="btn sm" href={alt}>{en ? `Open the ${otherName} page` : `เปิดหน้า${otherName}`}</a>}
      <button type="button" class="btn sm" data-sync-accept>{en ? 'Mark as in step' : 'ถือว่าตรงกันแล้ว'}</button>
    </div>
  </div>
  <details class="dev-links" data-links hidden>
    <summary data-links-title></summary>
    <ul class="dev-links-list" data-links-list></ul>
  </details>
  <textarea spellcheck="false" aria-label={file} rows="12"></textarea>
  <div class="dev-editor-foot">
    <span class="dev-editor-status" data-edit-status aria-live="polite"></span>
    <div class="dev-editor-bar">
      <DevEditToggle />
      <span class="spacer"></span>
      <button type="button" class="btn sm" data-edit-discard>{en ? 'Discard changes' : 'ทิ้งการแก้ไข'}</button>
      <button type="button" class="btn sm primary" data-edit-save>{en ? 'Save (Ctrl+S)' : 'บันทึก (Ctrl+S)'}</button>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var ed = document.querySelector('.dev-editor');
    if (!ed) return;
    var area = ed.querySelector('textarea');
    var statusEl = ed.querySelector('[data-edit-status]');
    var file = ed.dataset.file;
    var views = document.querySelectorAll('[data-edit-view]');
    var edits = document.querySelectorAll('[data-edit-edit]');
    var KEY = 'garden:edit'; // '1' while Edit is on, so a reload of the page comes back into Edit
    var DRAFT = KEY + '-draft'; // what is in the box, so a reload never loses it
    var CARET = KEY + '-caret';
    var H = { 'x-garden-edit': '1' };
    var eol = '\n';
    // The text that is on disk. null means "not known to match the box" (after a refused save), so the box counts as unsaved.
    var saved = '';
    var busy = false;

    function say(msg, kind) {
      statusEl.textContent = msg || '';
      statusEl.dataset.kind = kind || '';
    }
    // ---- Thai / English twin check (the server runs tools/translation-sync.mjs) ----
    var syncBox = ed.querySelector('[data-sync]');
    var syncTitle = ed.querySelector('[data-sync-title]');
    var syncList = ed.querySelector('[data-sync-list]');
    var syncActions = ed.querySelector('[data-sync-actions]');
    var dots = document.querySelectorAll('[data-sync-dot]');
    var syncCopy = '';
    function when(t) {
      var d = new Date(t);
      var days = Math.floor((Date.now() - d.getTime()) / 86400000);
      var abs = d.toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
      return abs + ' (' + (days < 1 ? ed.dataset.tSyncToday : days + ' ' + ed.dataset.tSyncDays) + ')';
    }
    function showSync(s) {
      syncCopy = '';
      if (!s || s.error) {
        syncBox.hidden = true;
        dots.forEach(function (d) { d.hidden = true; });
        return;
      }
      var out = !!s.mismatch || s.stale.length > 0;
      syncBox.hidden = false;
      syncBox.dataset.state = out ? 'out' : 'ok';
      syncList.textContent = '';
      syncActions.hidden = !out;
      if (s.mismatch) {
        syncTitle.textContent = ed.dataset.tSyncMismatch + ' (' + s.mismatch.th + ' / ' + s.mismatch.en + ')';
        syncActions.hidden = true;
      } else if (!s.stale.length) {
        syncTitle.textContent = ed.dataset.tSyncOk + ' (' + s.total + ' ' + ed.dataset.tSyncUnits + ')';
      } else {
        var enBehind = s.stale.filter(function (u) { return u.state === 'en-behind'; });
        var thBehind = s.stale.filter(function (u) { return u.state === 'th-behind'; });
        syncTitle.textContent = [enBehind.length ? ed.dataset.tSyncEnBehind : '', thBehind.length ? ed.dataset.tSyncThBehind : ''].filter(Boolean).join('; ');
        s.stale.forEach(function (u) {
          var li = document.createElement('li');
          var b = document.createElement('strong');
          b.textContent = u.heading ? u.label.replace(/: .*$/, '') + ': ' + u.heading : u.label;
          li.appendChild(b);
          li.appendChild(document.createTextNode(' ' + ed.dataset.tSyncEdited + ' ' + when(u.since) + (u.state === 'th-behind' ? ' (EN)' : ' (TH)')));
          syncList.appendChild(li);
        });
        syncCopy = s.copy;
      }
      dots.forEach(function (d) {
        d.hidden = false;
        d.dataset.state = out ? 'out' : 'ok';
        d.title = syncTitle.textContent;
      });
    }
    function refreshSync() {
      return fetch('/__edit?sync=1&file=' + encodeURIComponent(file), { headers: H })
        .then(parse)
        .then(function (r) { showSync(r.j.ok ? r.j.sync : null); })
        .catch(function () { showSync(null); });
    }
    // ---- What links here (the server runs tools/lesson-refs.mjs --graph) ----
    var linksBox = ed.querySelector('[data-links]');
    var linksTitle = ed.querySelector('[data-links-title]');
    var linksList = ed.querySelector('[data-links-list]');
    function showLinks(r) {
      if (!r || r.error) { linksBox.hidden = true; return; }
      linksBox.hidden = false;
      linksList.textContent = '';
      if (!r.links.length) { linksTitle.textContent = ed.dataset.tLinksNone; return; }
      linksTitle.textContent = r.links.length + ' ' + ed.dataset.tLinksSome;
      r.links.forEach(function (l) {
        var li = document.createElement('li');
        var c = document.createElement('code');
        c.textContent = l.from.replace(/^src\/content\/lessons(-en)?\//, '') + ':' + l.line;
        li.appendChild(c);
        li.appendChild(document.createTextNode(' ' + (l.frag ? '#' + l.frag : ed.dataset.tLinksWhole)));
        linksList.appendChild(li);
      });
    }
    function refreshLinks() {
      return fetch('/__edit?links=1&file=' + encodeURIComponent(file), { headers: H })
        .then(parse)
        .then(function (r) { showLinks(r.j.ok ? r.j : null); })
        .catch(function () { showLinks(null); });
    }
    ed.querySelector('[data-sync-copy]').addEventListener('click', function (e) {
      var btn = e.currentTarget;
      var label = btn.textContent;
      navigator.clipboard.writeText(syncCopy).then(function () {
        btn.textContent = ed.dataset.tSyncCopied;
        setTimeout(function () { btn.textContent = label; }, 1500);
      });
    });
    ed.querySelector('[data-sync-accept]').addEventListener('click', function () {
      fetch('/__edit', { method: 'POST', headers: Object.assign({ 'content-type': 'application/json' }, H), body: JSON.stringify({ file: file, action: 'accept' }) })
        .then(parse)
        .then(function (r) { showSync(r.j.ok ? r.j.sync : null); });
    });

    function blocked(on) {
      views.forEach(function (b) { b.dataset.blocked = on ? '1' : ''; });
    }
    // The text box takes the height of its text, so the page scrolls like the page it replaces.
    function grow() {
      area.style.height = 'auto';
      area.style.height = area.scrollHeight + 2 + 'px';
    }
    function setMode(on) {
      if (on) {
        root.setAttribute('data-edit', '');
        // Edit always uses the layout of the long page (header, lesson list, title), also when the learner reads step by step.
        // Only the attribute changes, not the saved choice, and View reloads the page, which puts the saved choice back.
        root.dataset.view = 'read';
      } else root.removeAttribute('data-edit');
      views.forEach(function (b) { b.setAttribute('aria-pressed', String(!on)); });
      edits.forEach(function (b) { b.setAttribute('aria-pressed', String(on)); });
    }
    function dirty() { return area.value !== saved; }
    function keepDraft() {
      try { sessionStorage.setItem(DRAFT, JSON.stringify({ file: file, text: area.value })); } catch (e) { /* too big: skip */ }
    }
    function dropDraft() { sessionStorage.removeItem(DRAFT); }
    function parse(r) {
      return r.json().then(function (j) { return { status: r.status, j: j }; });
    }
    function load() {
      say(ed.dataset.tLoading, '');
      return fetch('/__edit?file=' + encodeURIComponent(file), { headers: H })
        .then(parse)
        .then(function (r) {
          if (!r.j.ok) throw new Error(r.j.error);
          eol = r.j.text.indexOf('\r\n') >= 0 ? '\r\n' : '\n';
          saved = r.j.text.replace(/\r\n/g, '\n');
          area.value = saved;
          grow();
          blocked(false);
          say('', '');
        })
        .catch(function (e) { say(ed.dataset.tFailed + ' ' + e.message, 'error'); });
    }
    // Back to the page. The dev server does not reload the page when this editor saves, so do it here, once.
    function leave() {
      sessionStorage.removeItem(KEY);
      sessionStorage.removeItem(CARET);
      dropDraft();
      location.reload();
    }
    function applyResult(j) {
      if (j.ok) {
        saved = area.value;
        dropDraft();
        blocked(false);
        say(ed.dataset.tSaved, 'ok');
        if (j.sync !== undefined) showSync(j.sync);
        return true;
      }
      var why = j.stage === 'compile' ? ed.dataset.tCompile : j.stage === 'frontmatter' ? ed.dataset.tFrontmatter : j.stage === 'render' ? ed.dataset.tRender : '';
      saved = null;
      say(ed.dataset.tFailed + ' ' + (why ? why + ': ' : '') + j.error, 'error');
      blocked(true);
      return false;
    }
    // Resolves true when the text on disk equals the text in the box and the page renders with it.
    function save() {
      if (!dirty()) return Promise.resolve(true);
      if (busy) return Promise.resolve(false);
      busy = true;
      say(ed.dataset.tSaving, '');
      keepDraft();
      sessionStorage.setItem(CARET, JSON.stringify({ s: area.selectionStart, y: window.scrollY }));
      return fetch('/__edit', {
        method: 'POST',
        headers: Object.assign({ 'content-type': 'application/json' }, H),
        body: JSON.stringify({ file: file, text: area.value.replace(/\n/g, eol), page: location.pathname }),
      })
        .then(parse)
        .then(function (r) {
          busy = false;
          return applyResult(r.j);
        })
        .catch(function (e) {
          busy = false;
          say(ed.dataset.tFailed + ' ' + e.message, 'error');
          blocked(true);
          return false;
        });
    }
    function enter() {
      setMode(true);
      sessionStorage.setItem(KEY, '1');
      return load().then(function () {
        // If the page was reloaded while the box held text that is not on disk, put that text back.
        try {
          var d = JSON.parse(sessionStorage.getItem(DRAFT) || 'null');
          if (d && d.file === file && typeof d.text === 'string' && d.text !== area.value) {
            area.value = d.text;
            grow();
            say(ed.dataset.tRestored, '');
          }
        } catch (e) { /* no draft */ }
        var back = null;
        try { back = JSON.parse(sessionStorage.getItem(CARET) || 'null'); } catch (e) { /* nothing to restore */ }
        area.focus({ preventScroll: true });
        if (back) {
          area.setSelectionRange(back.s, back.s);
          window.scrollTo(0, back.y || 0);
        } else {
          // coming from the page: show the top of the editor, just under the header
          var top = ed.getBoundingClientRect().top + window.scrollY - 90;
          window.scrollTo(0, Math.max(0, top));
        }
      });
    }

    edits.forEach(function (b) { b.addEventListener('click', function () { if (!root.hasAttribute('data-edit')) enter(); }); });
    views.forEach(function (b) {
      b.addEventListener('click', function () {
        if (!root.hasAttribute('data-edit')) return;
        save().then(function (ok) { if (ok) leave(); });
      });
    });
    ed.querySelector('[data-edit-save]').addEventListener('click', function () { save(); });
    ed.querySelector('[data-edit-discard]').addEventListener('click', function () {
      dropDraft();
      load();
    });
    area.addEventListener('input', function () {
      grow();
      keepDraft();
      blocked(false);
      if (statusEl.dataset.kind === 'ok') say('', '');
    });
    area.addEventListener('keydown', function (e) {
      if ((e.ctrlKey || e.metaKey) && (e.key === 's' || e.key === 'S')) {
        e.preventDefault();
        save();
      }
    });
    window.addEventListener('resize', function () { if (root.hasAttribute('data-edit')) grow(); });
    window.addEventListener('beforeunload', function (e) {
      if (root.hasAttribute('data-edit') && dirty()) { e.preventDefault(); e.returnValue = ed.dataset.tLeave; }
    });
    refreshSync();
    refreshLinks();
    if (sessionStorage.getItem(KEY) === '1') enter();
  })();
</script>
