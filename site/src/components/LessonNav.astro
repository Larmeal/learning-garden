---
import { pad, lessonHref } from '../lib/garden';
import type { Lesson } from '../lib/garden';

interface Props {
  lessons: Lesson[];
  phases: { id: string; title: string }[];
  currentId: string;
}
const { lessons, phases, currentId } = Astro.props;
---

<nav class="lnav" aria-label="สารบัญหัวข้อ">
  {
    phases.map((p) => {
      const inPhase = lessons.filter((l) => l.data.phase === p.id);
      return (
        inPhase.length > 0 && (
          <div>
            <h4>
              ช่วง {p.id} · {p.title}
            </h4>
            <ul>
              {inPhase.map((l) => (
                <li>
                  <a href={lessonHref(l.id)} aria-current={l.id === currentId ? 'page' : undefined}>
                    <span class="n">{pad(l.data.order)}</span>
                    <span>{l.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      );
    })
  }
</nav>
